#!/bin/bash
# Filename: gitst.sh
# Author: Luis Henriquez <luis@luishp.xyz>
# Created: 2024-12-17 15:05:18
# Description: File meant to initialyze my dotfiles.

DOTFILE_URL = https://github.com/Luis-Henriquez-Perez/dotfiles
DOTFILE_DIR = $HOME/.dotfiles

git clone --bare $DOTFILE_URL $DOTFILE_DIR
function dot {
   /usr/bin/git --git-dir=$DOTFILE_DIR --work-tree=$HOME $@
}
mkdir -p .config-backup
dot checkout
if [ $? = 0 ]; then
  echo "Checked out config.";
  else
    echo "Backing up pre-existing dot files.";
    dot checkout 2>&1 | egrep "\s+\." | awk {'print $1'} | xargs -I{} mv {} .config-backup/{}
fi;
dot checkout
dot config status.showUntrackedFiles no
