#!/bin/sh

wallpaper_dir="$HOME/Pictures/wallpapers/"
wallpaper_download_script="$HOME/Downloads/wallhaven-downloader/wallhaven.sh"
resolution=$(xrandr | awk '/\*/ {print $1}')

# Should be in multiples of 24 (the script downloads wallpapers by page and each
# page has 24 wallpapers).
wallpaper_number=24

tmp_sfw=$(mktemp -d)
tmp_sketchy=$(mktemp -d)
tmp_nsfw=$(mktemp -d)

cleanup() {
    echo "Cleaning up temp directories..."
    rm -rf "$tmp_sfw" "$tmp_sketchy" "$tmp_nsfw"
}

move_and_rename() {
    temp_dir=$1
    prefix=$2

    for file in "$temp_dir"/*; do

        # Get the filename without the path
        base=$(basename "$file")

        # Get the full path of the new filename
        newname="$wallpaper_dir${prefix}_$base"

        # Rename the file
        # echo "Renaming file with $prefix from $file to $newname..."
        mv -- "$file" "$newname"
    done
}

# Download SFW wallpapers.
echo "Downloading $wallpaper_number SFW wallpapers to $wallpaper_dir..."
{
    "$wallpaper_download_script" \
    --number "$wallpaper_number" \
    --filter 100 \
    --location "$tmp_sfw" \
    --categories 101 \
    --type standard \
    --resolution "$resolution" \
    --parallel 1 \
    --mode random
} > /dev/null 2>&1

echo "Downloading $wallpaper_number sketchy wallpapers to $wallpaper_dir..."
{
    "$wallpaper_download_script" \
    --number "$wallpaper_number" \
    --filter 010 \
    --location "$tmp_sketchy" \
    --categories 101 \
    --type standard \
    --resolution "$resolution" \
    --parallel 1 \
    --mode random
} > /dev/null 2>&1

echo "Downloading $wallpaper_number NSFW wallpapers to $wallpaper_dir..."
{
    "$wallpaper_download_script" \
    --number "$wallpaper_number" \
    --filter 001 \
    --location "$tmp_nsfw" \
    --categories 101 \
    --type standard \
    --resolution "$resolution" \
    --parallel 1 \
    --mode random
} > /dev/null 2>&1

move_and_rename "$tmp_sfw" "sfw"
move_and_rename "$tmp_sketchy" "sketchy"
move_and_rename "$tmp_nsfw" "nsfw"

trap cleanup EXIT

