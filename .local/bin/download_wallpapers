#!/bin/sh

# I struggled with the choise of whether to make 3 separate directories for SFW,
# sketch, and NSFW wallpapers or whether to just prefix their names.  In the end
# I decided to just prefix their names, this way even if I accidentally get them
# isolated or mixed up I will know what kind of wallpaper it is.
wallpaper_dir="$HOME/Pictures/wallpapers/"
wallpaper_download_script="$HOME/Downloads/wallhaven-downloader/wallhaven.sh"
# TODO: dynamically get the screen resolution
# screen_resolution=$(xrandr | awk '/\*/ {print $1}')

# Should be in multiples of 24 (the script downloads wallpapers by page and each
# page has 24 wallpapers).
wallpaper_number=24

# Download SFW wallpapers.
echo "Downloading $wallpaper_number SFW wallpapers to $test_wallpaper_dir..."
"$wallpaper_download_script" \
    --number "$wallpaper_number" \
    --filter 100 \
    --location "$wallpaper_dir" \
    --categories 101 \
    --type standard \
    --resolution 1440x900 \
    --parallel 1 \
    --mode random
> /dev/null 2>&1

# Put them in a temp directory and then rename all the files to have the prefix sketchy-.
echo "Downloading $wallpaper_number sketchy wallpapers to $nsfw_wallpaper_dir..."
"$wallpaper_download_script" \
    --number "$wallpaper_number" \
    --filter 010 \
    --location "$wallpaper_dir" \
    --categories 101 \
    --type standard \
    --resolution 1440x900 \
    --parallel 1 \
    --mode random
> /dev/null 2>&1

# Download NSFW wallpapers into special directory.
echo "Downloading $wallpaper_number NSFW wallpapers to $nsfw_wallpaper_dir..."
"$wallpaper_download_script" \
    --number "$wallpaper_number" \
    --filter 001 \
    --location "$wallpaper_dir" \
    --categories 101 \
    --type standard \
    --resolution 1440x900 \
    --parallel 1 \
    --mode random
> /dev/null 2>&1

# Ensure NSFW wallpapers are prefixed with "nsfw_" for easier handling.
for file in "$nsfw_wallpaper_dir"/*; do

    [ -f "$file" ] || continue

    # Get the filename without the path
    filename=$(basename "$file")

    # Skip if it's already prefixed with "NSFW_"
    case "$filename" in
        nsfw_*) continue ;;
    esac

    # Get the full path of the new filename
    newname="$nsfw_wallpaper_dir/nsfw_$filename"

    # Rename the file
    mv -- "$file" "$newname"
done
