#!/bin/sh

# I struggled with the choise of whether to make 3 separate directories for SFW,
# sketch, and NSFW wallpapers or whether to just prefix their names.  In the end
# I decided to just prefix their names, this way even if I accidentally get them
# isolated or mixed up I will know what kind of wallpaper it is.
wallpaper_dir="$HOME/Pictures/wallpapers/"
wallpaper_download_script="$HOME/Downloads/wallhaven-downloader/wallhaven.sh"
resolution=$(xrandr | awk '/\*/ {print $1}')
# TODO: dynamically get the screen resolution
# screen_resolution=

# Should be in multiples of 24 (the script downloads wallpapers by page and each
# page has 24 wallpapers).
wallpaper_number=24

tmp_sfw=$(mktemp -d)
tmp_sketchy=$(mktemp -d)
tmp_nsfw=$(mktemp -d)

cleanup() {
    rm -rf "$tmp_sfw" "$tmp_sketchy" "$tmp_nsfw"
}

move_and_rename() {
    temp_dir=$1
    prefix=$2

    for file in "$temp_dir"/*; do

        [ -f "$file" ] || continue

        # Get the filename without the path
        base=$(basename "$file")

        # Get the full path of the new filename
        newname="$wallpaper_dir/$prefix_$base"

        # Rename the file
        mv -- "$file" "$newname"
    done
}

# Download SFW wallpapers.
echo "Downloading $wallpaper_number SFW wallpapers to $wallpaper_dir..."
"$wallpaper_download_script" \
    --number "$wallpaper_number" \
    --filter 100 \
    --location "$tmp_sfw" \
    --categories 101 \
    --type standard \
    --resolution "$resolution" \
    --parallel 1 \
    --mode random
> /dev/null 2>&1

# Put them in a temp directory and then rename all the files to have the prefix sketchy-.
echo "Downloading $wallpaper_number sketchy wallpapers to $wallpaper_dir..."
"$wallpaper_download_script" \
    --number "$wallpaper_number" \
    --filter 010 \
    --location "$tmp_sketchy" \
    --categories 101 \
    --type standard \
    --resolution "$resolution" \
    --parallel 1 \
    --mode random
> /dev/null 2>&1

# Download NSFW wallpapers into special directory.
echo "Downloading $wallpaper_number NSFW wallpapers to $wallpaper_dir..."
"$wallpaper_download_script" \
    --number "$wallpaper_number" \
    --filter 001 \
    --location "$tmp_nsfw" \
    --categories 101 \
    --type standard \
    --resolution "$resolution" \
    --parallel 1 \
    --mode random
> /dev/null 2>&1

move_and_rename "$tmp_sfw" "sfw"
move_and_rename "$tmp_sketchy" "sketchy"
move_and_rename "$tmp_nsfw" "nsfw"

trap cleanup EXIT

