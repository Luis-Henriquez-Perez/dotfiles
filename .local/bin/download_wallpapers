#!/bin/sh

test_wallpaper_dir="$HOME/Pictures/test-wallpapers/"
nsfw_wallpaper_dir="$HOME/Pictures/nsfw-wallpapers/"
wallpaper_download_script="$HOME/Downloads/wallhaven-downloader/wallhaven.sh"

# Should be in multiples of 24 (the script downloads wallpapers by page and each
# page has 24 wallpapers).
wallpapers_to_download=72

# Download SFW wallpapers.
echo "Downloading $wallpapers_to_download SFW wallpapers..."
"$wallpaper_download_script" \
    --number "$wallpapers_to_download" \
    # no NSFW posts.
    --filter 110 \
    --location "$test_wallpaper_dir" \
    # No anime
    --categories 101 \
    --type standard \
    --resolution 1440x900 \
    --parallel 1 \
    --mode random

# Download NSFW wallpapers into special directory.
echo "Downloading $nsfw_wallpapers_to_download NSFW wallpapers..."
"$wallpaper_download_script" \
    --number "$wallpapers_to_download" \
    # Include NSFW posts.
    --filter 111 \
    --location "$nsfw_wallpaper_dir" \
    --categories 101 \
    --type standard \
    --resolution 1440x900 \
    --parallel 1 \
    --mode random

# Ensure NSFW wallpapers are prefixed with "NSFW" for easier handling.
for file in "$nsfw_wallpaper_dir"/*; do
    # Get the filename without the path
    filename=$(basename "$file")

    # Skip if it's already prefixed with "NSFW_"
    case "$filename" in
        nsfw_*) continue ;;
    esac

    # Get the full path of the new filename
    newname="$nsfw_wallpaper_dir/nsfw_$filename"

    # Rename the file
    mv -- "$file" "$newname"
done
