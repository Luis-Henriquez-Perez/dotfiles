#!/bin/bash

wallpaper_dir="$HOME/Pictures/test-wallpapers/"
nsfw_wallpaper_dir="$HOME/Pictures/nsfw-wallpapers/"
wallpaper_download_script="$HOME/Downloads/wallhaven-downloader/wallhaven.sh"

wallpapers_to_download=72

# Download SFW walpapers.
echo "Downloading $wallpapers_to_download wallpapers..."
"$wallpaper_download_script" \
    --number "$wallpapers_to_download" \
    --filter 110 \
    --location "$wallpaper_dir" \
    --categories 101 \
    --type standard \
    --resolution 1440x900 \
    --parallel 1 \
    --mode random

# Download NSFW wallpapers into special directory.
echo "Downloading NSFW $nsfw_wallpapers_to_download wallpapers..."
"$wallpaper_download_script" \
    --number "$wallpapers_to_download" \
    --filter 111 \
    --location "$wallpaper_dir" \
    --categories 101 \
    --type standard \
    --resolution 1440x900 \
    --parallel 1 \
    --mode random

# Ensure NSFW wallpapers are prefixed with "NSFW" for easier handling.
for f in *; do
  [ -f "$f" ] && mv -- "$f" "NSFW-$f"
done

wallpaper_count=$(find "$wallpaper_dir" -type f \( -name "*.jpg" -o -name "*.png" \) | wc -l)
