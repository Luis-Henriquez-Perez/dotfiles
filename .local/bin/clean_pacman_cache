#!/bin/sh
# Filename: clean_pacman_cache
# Author: Luis Henriquez-Perez <luis@luishp.xyz>
# Created: 2025-07-02 19:05:13
# Description: Clean the pacman cache.
# There is a script provided by `pacman-contrib` that does this, but ID rather
# do it mself.

# Keep last N versions of each package in pacman cache (without using paccache)

# How many versions to keep
KEEP=3

# Cache directory
CACHE_DIR="/var/cache/pacman/pkg"

# Temp file
# TMPFILE="$(mktemp)"

cd "$CACHE_DIR" || exit 1

# List all cached packages
# Format: name-ver-rel.pkg.tar.zst
for pkg in *.pkg.tar.*; do
    # Get package base name (e.g., "vim" from "vim-9.0.123-1-x86_64.pkg.tar.zst")
    base="$(echo "$pkg" | sed -E 's/-[^-]+-[^-]+-[^-]+\.pkg\.tar\..+//' )"
    echo "$base -> $pkg"
    # Get the version of the package and count the number of versions.  If there
    # are more than three versions the oldests so there are only three left.
    # echo "$pkg:$base" >> "$TMPFILE"
    # how to compare versions in shell?
done

# rm -f "$TMPFILE"
