#!/bin/sh
# Filename: setup_systemd_services.sh
# Author: Luis Henriquez-Perez <luis@luishp.xyz>
# Created: 2024-12-17 05:35:08
# Description: Initialize systemd services.
# For a new system, this is meant to setup all my system services.

# I can simply use the existing service files for uers services.

# System services
systemctl enable --now NetworkManager
systemctl enable --now gpg-agent
systemctl enable --now systemd-timesyncd

# User services
systemctl --user enable --now emacs
systemctl --user enable --now picom
systemctl --user enable --now dunst

# timers
systemctl --user enable --now set_wallpaper.timer
systemctl --user enable --now download_email.timer
systemctl --user enable --now download_wallpapers.timer
systemctl --user enable --now push_dotfiles.timer
systemctl --user enable --now clean_system.timer

# External hardrive
# Create the mountpoint for the hardrive.
# Enable the system stuff for it.

echo "Systemd service setup completed."

# Setup external drive stuff.
