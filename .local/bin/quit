#!/bin/sh

chosen=$(printf "%s\n" "[Cancel]" "Shutdown" "Logout" "Reboot" "Suspend" "Hibernate" "Hybrid-sleep" "Suspend-then-hibernate" | rofi -dmenu -i -no-fixed-num-lines -p "What do you want to do?")

if [ "$chosen" = "Shutdown" ]; then
    systemctl poweroff
elif [ "$chosen" = "Logout" ]; then
    jwm -exit
elif [ "$chosen" = "Reboot" ]; then
    systemctl reboot
elif [ "$chosen" = "Suspend" ]; then
    systemctl suspend
elif [ "$chosen" = "Hibernate" ]; then
    systemctl hibernate
elif [ "$chosen" = "Hybrid-sleep" ]; then
    systemctl hibernate
elif [ "$chosen" = "Suspend-then-hibernate" ]; then
    systemctl suspend-then-hibernate
fi
