#!/bin/bash
# Filename: wallpaper_to_trash.sh
# Author: Luis Henriquez <luis@luishp.xyz>
# Created: 2024-12-22 19:32:25
# Description: Script that lets me interactively select wallpapers with sxiv to
# send to trash.

# Directory containing wallpapers
WALLPAPER_DIR="$HOME/Pictures/wallpapers"

# Directory for trashed wallpapers
TRASH_DIR="$HOME/Trash"

# Ensure the trash directory exists
mkdir -p "$TRASH_DIR"

# Check if nsxiv is installed
if ! command -v nsxiv &> /dev/null; then
    echo "nsxiv is not installed. Please install it first."
    exit 1
fi

# Function to move a file to trash
move_to_trash() {
    local file="$1"
    if [ -f "$file" ]; then
        mv "$file" "$TRASH_DIR"
        echo "Moved $file to trash"
    else
        echo "Could not move $file to trash"
    fi
}

# Use nsxiv to select files
selected_files=$(nsxiv -o "$WALLPAPER_DIR")

# Process each selected file
for file in $selected_files; do
    move_to_trash "$file"
done
