#!/bin/bash
# Filename: script_screenshot.sh
# Author: Luis Henriquez <luis@luishp.xyz>
# Created: 2024-12-19 08:27:49
# Description: This is a script designed to take a picture of my full screen.

screenshot_dir="$HOME/Pictures/screenshots/"
screenshot="$screenshot_dir/screenshot_$(date +%Y%m%d_%H%M%S).png"

fullscreen_screenshot() {
    maim "$screenshot"
    notify-send "screenshot" "Fullscreen Screenshot taken"
}

window_screenshot() {
    win_id=$(xdotool getactivewindow)
    maim -i "$win_id" "$screenshot"
    notify-send "Screenshot" "Window screenshot taken"

}

manage_screenshots() {
    nsxiv -t "$screenshot_dir"
}

case "$1" in
    "")
        fullscreen_screenshot
        ;;
    -w|--window)
        window_screenshot
        ;;
    -m|--manage)
        manage_screenshots
        ;;
    *)
        echo "Usage: $0 {delete}"
        exit 1
        ;;
esac
