#!/bin/sh
# Filename: wallpaper
# Author: Luis Henriquez-Perez <luis@luishp.xyz>
# Created: 2025-07-03 07:32:24
# Description: Manage wallpapers with nsxiv.
# Specifically this means let me easily look at each wallpaper and choose
# whether to either move it to the trash or add it to my git repo.

# Directory containing wallpapers
wallpaper_dir="$HOME/Pictures/wallpapers"
trash="$HOME/Trash"
used_wallpapers_file="$HOME/.cache/used_wallpapers_file"

delete_wallpaper() {
    # Ensure the used wallpapers file exists
    [ -f "$used_wallpapers_file" ] || touch "$used_wallpapers_file"

    # Get the last used wallpaper
    last_wallpaper=$(tail -n 1 "$used_wallpapers_file")

    # If there's nothing to delete
    if [ -z "$last_wallpaper" ]; then
        echo "No wallpaper to delete."
        return 1
    fi
    # # Make a deleted wallpaper directory just so things are neater.  I can go to
    # # just one dedicated directory to find all the wallpapers I deleted instead of
    # # scowering my trash directory.
    # mkdir -p ""
    # Remove the last line from used wallpapers file
    tmpfile=$(mktemp)
    sed '$d' "$used_wallpapers_file" > "$tmpfile" && mv "$tmpfile" "$used_wallpapers_file"

    mv "$last_wallpaper" "$trash"
    echo "Moved $last_wallpaper to $trash"
    notify-send "Wallpaper" "Deleted $last_wallpaper..."
}

switch_wallpaper() {
    # Ensure the used wallpapers file exists
    [ -f "$used_wallpapers_file" ] || touch "$used_wallpapers_file"

    # Use temp files for correct handling
    all_file=$(mktemp)
    used_file=$(mktemp)

    # Store all wallpapers (sorted)
    find "$wallpaper_dir" -type f \( -iname "*.jpg" -o -iname "*.png" \) | sort > "$all_file"
    sort "$used_wallpapers_file" > "$used_file"

    # Get a random unused wallpaper
    chosen=$(comm -23 "$all_file" "$used_file" | shuf -n 1)

    # If none found, reset
    if [ -z "$chosen" ]; then
        echo "No new wallpapers found. Resetting used wallpapers."
        : > "$used_wallpapers_file"
        chosen=$(cat "$all_file" | shuf -n 1)
    fi
    # Set wallpaper to chosen.

    # Clean up temp files
    rm -f "$all_file" "$used_file"

    # If I am version controlling the pckture, remove it from version-control.
    # notify-send "Switched wallpaper to $chosen!"

    # Append and set
    echo "$chosen" >> "$used_wallpapers_file"
    xwallpaper --stretch "$chosen"
}

save_wallpaper() {
    # Check whether wallpaper is already tracked.
    # Do this from the home directory.
    git add "$last_wallpaper"
    git commit -m "Add wallpaper: $last_wallpaper." "$last_wallpaper"
    notify-send "Wallpaper" "Saved $last_wallpaper!"
}

manage_wallpapers() {
    trash_dir="$HOME/Trash"

    mapfile -t files < <(
        git -C "$wallpaper_dir" ls-files --others --exclude-standard \
            | grep -E '\.(jpg|jpeg|png|webp)$' \
            | sed "s|^|$wallpaper_dir/|"
    )

    [ "${#files[@]}" -eq 0 ] && echo "No untracked wallpapers found." && return

    nsxiv -t "${files[@]}"
}

choose_wallpaper() {
    local chosen
    # Open nsxiv in thumbnail mode, pick one file, and capture its output
    chosen=$(nsxiv -ot "$wallpaper_dir")
    if [ -n "$chosen" ]; then
        xwallpaper --stretch "$chosen"
    else
        echo "No wallpaper selected."
    fi
}

case "$1" in
    "")
        switch_wallpaper
        ;;
    -d|--delete)
        delete_wallpaper
        switch_wallpaper
        ;;
    -s|--save)
        save_wallpaper
        ;;
    -S|--switch)
        save_wallpaper
        switch_wallpaper
        ;;
    -m|--manage)
        manage_wallpapers
        ;;
    -r|--restore)
        restore_wallpapers
        ;;
    -l|--download)
        download_wallpapers
        ;;
    -c|--choose)
        choose_wallpaper
        ;;
    *)
        set_wallpaper
        ;;
esac
