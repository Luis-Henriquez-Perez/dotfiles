case "$1" in
    "")
        switch_wallpaper
        ;;
    -d|--delete)
        delete_wallpaper
        switch_wallpaper
        ;;
    -s|--save)
        save_wallpaper
        ;;
    -S|--switch)
        save_wallpaper
        switch_wallpaper
        ;;
    -m|--manage)
        manage_wallpapers
        ;;
    -r|--restore)
        restore_wallpapers
        ;;
    -l|--download)
        download_wallpapers
        ;;
    -c|--choose)
        choose_wallpaper
        ;;
    *)
        echo "Usage: $0 {delete}"
        exit 1
        ;;
esac
