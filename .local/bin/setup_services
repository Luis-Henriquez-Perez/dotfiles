#!/bin/sh
# Filename: setup_void_services
# Author: Luis Henriquez-Perez <luis@luishp.xyz>
# Created: 2025-06-19 14:15:36
# Description: Set up a runit service to manage user-specific services for <USER>.
# This means creating the system service directory which for my case is called
# "runit-user-luis".

set -eu

# Load OS info
. /etc/os-release 2>/dev/null

# Abort if not Void Linux
if [ "$ID" != "void" ]; then
    echo "This script is specific to void linux."
    exit 1
fi

# If I am using void linux do not run this.

# User for which to set up the service
USER="${1:-$USER}"
USER_HOME="$(eval echo ~$USER)"

SERVICE_NAME="runit-user-$USER"
SERVICE_DIR="/etc/sv/$SERVICE_NAME"
RUN_SCRIPT="$SERVICE_DIR/run"

create_user_service(){
    # 1. Create the service directory and script
    echo "Creating $SERVICE_NAME..."
    mkdir -p "$SERVICE_DIR"

    tee "$RUN_SCRIPT" >/dev/null <<EOF
#!/bin/sh
exec 2>&1
exec chpst -u $USER:$USER runsvdir $USER_HOME/runit/service
EOF

    chmod +x "$RUN_SCRIPT"

    # Optional: Add logging (e.g., /etc/sv/$SERVICE_NAME/log/run)
    # You could write log output to ~/.local/state/runit-logs or just stdout

    # 2. Enable the service
    echo "Linking $SERVICE_NAME into /var/service..."
    ln -sf "$SERVICE_DIR" /var/service/

    echo "$SERVICE_NAME is set up and enabled."
}

# Also add a way to undo this because who knows I might have to.

# Removing service directory and script
remove_user_service(){
    echo "Disable the service."
    rm -rf service-dir
    echo "Delete the service from the system."
}

