#!/bin/sh
# Filename: archiso
# Author: Luis M Henriquez <luis@luishp.xyz>
# Created: 2025-07-24 20:41:05
# Description: Download archiso and burn it to a usb.

set -e

DOWNLOAD_DIR="$HOME/Downloads"

ARCHWIKI_DOWNLOAD_PAGE=https://archlinux.org/download/
# ISO_URL="https://mirror.adectra.com/archlinux/iso/2025.07.01/archlinux-2025.07.01-x86_64.iso"
ISO_NAME="$DOWNLOAD_DIR/archlinux-x86_64.iso"
# ISO_SIG_URL="https://mirror.adectra.com/archlinux/iso/2025.07.01/archlinux-2025.07.01-x86_64.iso.sig"
# SIG_NAME="$DOWNLOAD_DIR/ISO_NAME.sig"
# KEY_ID="0xB7D453EC1A7484C3"  # Arch Linux Master Key

get_mirrors() {
    echo "Fetching mirror list from $BASE_URL..."
    curl -s "$BASE_URL" |
        grep -Eo 'https://[a-zA-Z0-9./_-]+/iso/[0-9.]+/' |
        sort -u
}

get_iso_links() {
    ISO_PAGE=$(curl -s "$MIRROR")
    ISO_FILE=$(echo "$ISO_PAGE" | grep -Eo 'archlinux-[0-9.]+-x86_64\.iso' | head -n1)
    SIG_FILE="$ISO_FILE.sig"

    ISO_URL="$MIRROR$ISO_FILE"
    SIG_URL="$MIRROR$SIG_FILE"
}

download_iso() {
    # TODO: webscrape the archlinux site and prompt me for download links.
    echo "Downloading latest Arch Linux ISO to downloads directory..."
    # [ -f "$ISO_NAME" ] || curl -Lo "$ISO_NAME" "$ISO_URL"
    # [ -f "$SIG_NAME" ] || curl -Lo "$SIG_NAME" "$ISO_SIG_URL"
    curl -LO "$ISO_URL"
    curl -LO "$ISO_SIG_URL"
}

verify_iso() {
    echo "Importing Arch Linux Master Key..."
    gpg --keyserver keyserver.ubuntu.com --recv-keys "$KEY_ID" || true
    echo "Verifying ISO signature..."
    gpg --verify "$SIG_NAME" "$ISO_NAME"
}

list_disks() {
    echo "Available removable disks:"
    lsblk -dpno NAME,SIZE,MODEL | grep -E "/dev/sd[b-z]"
}

prompt_for_usb() {
    echo ""
    read -rp "Enter the device path to write the ISO (e.g. /dev/sdX): " USB_DEV
    if [ ! -b "$USB_DEV" ]; then
        echo "Error: $USB_DEV is not a block device"
        exit 1
    fi
    read -rp "Are you sure you want to erase $USB_DEV? [y/N]: " CONFIRM
    if [ "$CONFIRM" != "y" ]; then
        echo "Aborted."
        exit 1
    fi
}

burn_iso() {
    echo "Writing ISO to $USB_DEV..."
    sudo dd bs=4M if="$ISO_NAME" of="$USB_DEV" status=progress oflag=sync
    echo "Done. You can now boot from $USB_DEV."
}

main() {
    download_iso
    verify_iso
    list_disks
    prompt_for_usb
    burn_iso
}

main "$@"
