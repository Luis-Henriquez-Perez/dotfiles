#!/bin/sh
# Filename: save_system
# Author: Luis Henriquez-Perez <luis@luishp.xyz>
# Created: 2025-06-12 11:36:08
# Description: Save my system to external hard drive.
# This script is for automating the backing up of all my stuff so I can easily
# setup the things I want on another machine.

# checklist
# 1. loose files
# 2. dotfiles

# TODO: prompt to mount the drive.  Since I do not know how to do that right now
# just hard-code the information.

# TODO: ensure that the drive is mounted

DRIVE="/mnt/harddrive"
BACKUP_DIR="$DRIVE/archlinux-home-2024-12-29"

# Directories to back up.  Essentially make a copy of my home directory
# excluding all version-controlled files.

TOBACKUP="
$HOME/Documents
$HOME/Pictures
$HOME/Downloads
$HOME/Music
$HOME/Videos
"

echo "Starting backup to $BACKUP_DIR"

# Build the list of excludes to exclude any git repos.

for DIR in $TOBACKUP; do
  if [ -d "$DIR" ]; then
    NAME=$(basename "$DIR")
    echo "→ Backing up $DIR to $BACKUP_DIR/$NAME"
    GIT_REPOS=$(find "$DIR" -type d -name .git -prune | sed 's|/\.git$||')
    # Build --exclude options for rsync
    EXCLUDES=""
    for repo in $GIT_REPOS; do
      REL_PATH="${repo#$DIR/}"
      EXCLUDES="$EXCLUDES --exclude=$REL_PATH"
    done
    # echo "$EXCLUDES"
    eval rsync -aAxv --dry-run --delete $EXCLUDES "$DIR/" "$BACKUP_DIR/$NAME/"
  else
    echo "⚠️  Skipping $DIR — not a directory or doesn't exist."
  fi
done

# find "Documents" -type d -name .git -prune | sed 's|/\.git||'
