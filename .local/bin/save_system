#!/bin/sh
# Filename: save_system
# Author: Luis Henriquez-Perez <luis@luishp.xyz>
# Created: 2025-06-12 11:36:08
# Description: Save my system to external hard drive.
# This script is for automating the backing up of all my stuff so I can easily
# setup the things I want on another machine.

USER_HOME="/home/luis"
PASSWORD_DIR=".local/share/.password-store"
PRIVATE_KEY_DIR=".gnupg/private-keys-v1.d"
# Right now this assumes that I have mounted my external drive to "/mnt/hardrive/".
DRIVE="/mnt/hardrive"
BACKUP_DIR="$DRIVE/archlinux-home-12-29-2024"

SOURCES="
$USER_HOME/Documents
$USER_HOME/Pictures
$USER_HOME/Downloads
$USER_HOME/Music
$USER_HOME/Videos
$USER_HOME/Trash
$USER_HOME/Sounds
$USER_HOME/$PASSWORD_DIR
$USER_HOME/$PRIVATE_KEY_DIR
"

backup() {
    echo "Backing up home directories to hardrive"
    # Build the list of excludes to exclude any git repos.
    for SOURCE in $SOURCES; do
        if [ -d "$SOURCE" ]; then
            TARGET="$BACKUP_DIR/${SOURCE#"$USER_HOME"/}"
            echo "$SOURCE → $TARGET"
            GIT_REPOS=$(find "$SOURCE" -type d -name .git -prune | sed 's|/\.git$||')
            EXCLUDES=""
            for repo in $GIT_REPOS; do
                REL_PATH="${repo#$SOURCE/}"
                EXCLUDES="$EXCLUDES --exclude=$REL_PATH"
            done
            mkdir -p "$TARGET"
            eval rsync -aAxv $EXCLUDES "$SOURCE/" "$TARGET/" >/dev/null
        else
            echo "⚠️  Skipping $SOURCE — not a directory or doesn't exist."
        fi
    done
    echo "Done backing up!"
}

restore() {
    echo "Restoring home directories from backup..."
    for SOURCE in $SOURCES; do
        TARGET="$BACKUP_DIR/${SOURCE#"$USER_HOME"/}"
        echo "$TARGET → $SOURCE"
        if [ -d "$SOURCE" ]; then
            mkdir -p "$SOURCE"
        rsync -aAxv "$TARGET" "$SOURCE" >/dev/null
        fi
    done
    echo "Restored!"
}

push_dotfiles() {
    emacs_dir="$HOME/.config/emacs/"
    awesome_dir="$HOME/.config/awesome/"

    # From the home directory.
    cd "$HOME" || {
        echo "Failed to change to home directory"
        exit 1
    }

    echo "Dotfiles pushed from $HOME"

    # Optional: make sure you're on the correct branch
    # git checkout main

    # Push my Emacs config to the cloud.
    git push origin HEAD

    cd "$emacs_dir" || {
        echo "Failed to change to home directory"
        exit 1
    }

    git push origin HEAD

    echo "Push Emacs directory."
}

push_branches() {
    # Push all local branches to origin
    for branch in $(git for-each-ref --format='%(refname:short)' refs/heads/); do
        # TODO: notify me if there is a new remote branch that had to be created and
        # silence output so I do not have to see everything.
        if ! git ls-remote --exit-code --heads origin "$branch" >/dev/null 2>&1; then
            echo "Creating new remote branch: $branch"
            git push -u origin "$branch" >/dev/null 2>&1
        else
            git push origin "$branch" >/dev/null 2>&1
        fi
        echo "Pushing branch: $branch"
    done
}

case "$1" in
    "" | backup)
        backup
        ;;
    restore)
        restore
        ;;
    *)
        echo "Usage: $0 {backup|restore}"
        exit 1
        ;;
esac
