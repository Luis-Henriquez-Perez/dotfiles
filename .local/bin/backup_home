#!/bin/sh
# Filename: backup_home
# Author: Luis Henriquez-Perez <luis@luishp.xyz>
# Created: 2025-06-12 11:36:08
# Description: Save my system to external hard drive.
# This script is for automating the backing up of all my stuff so I can easily
# setup the things I want on another machine.

set -eu

SOURCE=$HOME
DEST=${1:-/mnt/hardrive}/archlinux-home-$(date +%Y%m%d%M)

EXCLUDE_FILE="/tmp/EXCLUDE_FILE"

: > "$EXCLUDE_FILE"

echo "Downloads/"            >> $EXCLUDE_FILE
echo "Trash/"                >> $EXCLUDE_FILE
# I do not want duplicate copies of videos in my backups.  Therefore, I store
# them separately.
echo "Videos/"               >> $EXCLUDE_FILE
echo ".mail/"                >> $EXCLUDE_FILE
echo ".cache/"               >> $EXCLUDE_FILE
echo ".git/"                 >> $EXCLUDE_FILE
echo ".local/share/"         >> $EXCLUDE_FILE
echo ".mozilla/"             >> $EXCLUDE_FILE
echo ".config/chromium/"     >> $EXCLUDE_FILE
echo ".config/emacs/elpaca/" >> $EXCLUDE_FILE
echo ".config/emacs/elpa/"   >> $EXCLUDE_FILE

# Exclude files that are already tracked by my bare git repo.
git -C "$HOME" ls-files >> "$EXCLUDE_FILE"

# Exclude any git repos.
# find "$HOME" -mindepth 2 -type d -name ".git" -exec dirname {} \; >> "$EXCLUDE_FILE"

# mkdir -p "$DEST"
# cat "$EXCLUDE_FILE"

# Save videos separately.  I do not want to make duplicate copies of videos.

rsync -aAxv --delete \
      --dry-run \
      --exclude-from=$EXCLUDE_FILE \
      "$SOURCE" "$DEST"
