#!/bin/sh
# Filename: clean_trash
# Author: Luis Henriquez-Perez <luis@luishp.xyz>
# Created: 2025-09-16 03:52:51
# Description: Clean the trash directory.
# Create an intermediate step before actually deleting the files.
# Collect all the trash that needs to be removed into "trash bins" and delete
# the trash bindings that are too old.  This extra step gives some time before
# doing the undoable--actually deleting the files.

set -eu

DOWNLOADS_FOLDER="$HOME/Downloads/"

TRASH="$HOME/Trash"

echo "Clean the pacman cache..."

paccache -r -k 1 --min-atime "14 days ago"

echo "Cleaning $XDG_CONFIG_HOME..."

find "$XDG_CONFIG_HOME" -maxdepth 1 -type f -empty -exec rm -f {} \;

find "$XDG_CONFIG_HOME" -maxdepth 1 -type d -empty -exec rm -rf {} \;

echo "Cleaning $XDG_DATA_HOME..."

find "$XDG_DATA_HOME"  -maxdepth 1 -type f -empty -exec rm -f {} \;

find "$XDG_DATA_HOME" -maxdepth 1 -type d -empty -exec rm -rf {} \;

echo "Cleaning downloads directory..."

find "$DOWNLOADS" -maxdepth 1 -type d -mtime +60 -exec rm -rf {} \;

find "$DOWNLOADS" -maxdepth 1 -type f -mtime +60 -exec rm -f {} \;

echo "Cleaning the trash directory..."

find "$TRASH" -maxdepth 1 -type d -name '__pycache__' -exec rm -f {} \;

find "$TRASH" -maxdepth 1 -type f -name '*.pyo' -exec rm -f {} \;

find "$TRASH" -maxdepth 1 -type f -name '*.pyc' -exec rm -f {} \;

find "$TRASH" -maxdepth 1 -type f -name '*.iso' -exec rm -f {} \;

find "$TRASH" -maxdepth 1 -type f -name '*.rej' -exec rm -f {} \;

find "$TRASH" -maxdepth 1 -type f -mtime +10 -name '*.el' -exec rm -f {} \;

find "$TRASH" -maxdepth 1 -type f -name '*.elc' -exec rm -f {} \;

find "$TRASH" -maxdepth 1 -type d -mtime +10 -name '*.~*~' -exec rm -rf {} \;

find "$TRASH" -maxdepth 1 -type f -mtime +10 -name '*.~*~' -exec rm -f {} \;

find "$TRASH" -maxdepth 1 -xtype l -exec rm -f {} \;

find "$TRASH" -maxdepth 1 -type f -mtime +30 -exec rm -f {} \;

find "$TRASH" -maxdepth 1 -type d -mtime +30 -exec rm -rf {} \;

find "$TRASH" -maxdepth 1 -type f -empty -exec rm -f {} \;

find "$TRASH" -maxdepth 1 -type d -empty -exec rm -rf {} \;

echo "Done cleaning trash!"
