#!/bin/sh
# Filename: clean_system
# Author: Luis Henriquez-Perez <luis@luishp.xyz>
# Created: 2025-06-30 09:22:54
# Description: This is a script for cleaning my system.

TRASH="$HOME/Trash/"
DEST="$HOME/Trash/To-Actually-Delete"
# CONFIG_DIR="$XD"

clean_xdg_dir() {
    find "$XDG_CONFIG_HOME" -type f -empty -exec rm -f {}
    find "$XDG_CONFIG_HOME" -type d -empty -exec rm -f {}
}

clean_pacman_cache() {
    paccache -m "$DEST" -k 1
}

clean_trash() {
    # Create an intermediate step before actually deleting the file.
    mkdir -p DEST
    echo "Cleaning the trash directory..."

    deleted_pycache=$(find "$TRASH" -type d -name __pycache__ -exec mv -t "$DEST" {} + 2>/dev/null | wc -l)

    deleted_pyc=$(find "$TRASH" -type f \( -name '*.pyc' -o -name '*.pyo' \) -exec mv -t "$DEST" {} + 2>/dev/null | wc -l)

    deleted_elc=$(find "$TRASH" -type f -name '*.elc' -exec mv -t "$DEST" {} + 2>/dev/null | wc -l)

    deleted_iso=$(find "$TRASH" -type f -name '*.iso' -exec mv -t "$DEST" {} + 2>/dev/null | wc -l)

    deleted_rej=$(find "$TRASH" -type f -name '*.rej' -exec mv -t "$DEST" {} + 2>/dev/null | wc -l)

    deleted_symlinks=$(find "$TRASH" -xtype l -exec mv -t "$DEST" {} + 2>/dev/null | wc -l)

    deleted_old=$(find "$TRASH" -type f -mtime +90 -exec mv -t "$DEST" {} + 2>/dev/null | wc -l)

    # Empty files
    deleted_empty_files=$(find "$TRASH" -type f -empty -exec rm -f {} + 2>/dev/null | wc -l)

    # Empty dirs
    deleted_empty_dirs=$(find "$TRASH" -type d -empty -exec rm -f {} + 2>/dev/null | wc -l)

    echo "Deleted $deleted_pycache __pycache__ directories..."
    echo "Deleted $deleted_pyc Python compiled files (.pyc, .pyo)..."
    echo "Deleted $deleted_elc elisp compiled files..."
    echo "Deleted $deleted_empty_dirs empty directories..."
    echo "Deleted $deleted_empty_files empty files..."
    echo "Deleted $deleted_old very old files (over 90 days)..."
    echo "Deleted $deleted_iso ISOs..."
    echo "Deleted $deleted_symlinks broken symlinks..."
}

delete_orphans() {
    echo "deleting orphan packages..."
    sudo pacman -Rns $(pacman -Qdtq)
}

case "$1" in
    "")
        clean_pacman_cache
        clean_trash
        delete_orphans
        ;;
    -p|--packages)
        clean_pacman_cache
        ;;
    -t|--trash)
        clean_trash
        ;;
esac
