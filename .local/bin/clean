#!/bin/sh
# Filename: clean_system
# Author: Luis Henriquez-Perez <luis@luishp.xyz>
# Created: 2025-06-30 09:22:54
# Description: This is a script for cleaning my system.

TRASH="$HOME/Trash/"
DEST="$HOME/Trash/To-Actually-Delete"
DOWNLOADS_FOLDER="$HOME/Downloads/"

clean_xdg_dir() {
    find "$XDG_CONFIG_HOME" -type f -empty -exec rm -f {}
    find "$XDG_CONFIG_HOME" -type d -empty -exec rm -f {}

    find "$XDG_DATA_HOME" -type f -empty -exec rm -f {}
    find "$XDG_DATA_HOME" -type d -empty -exec rm -f {}
}

clean_pacman_cache() {
    paccache -m "$DEST" -k 1
}

clean_trash() {
    # Create an intermediate step before actually deleting the file.
    mkdir -p DEST
    echo "Cleaning the trash directory..."

    find "$TRASH" -type d -name __pycache__ -exec mv -t "$DEST" {}

    find "$TRASH" -type f \( -name '*.pyc' -o -name '*.pyo' \) -exec mv -t "$DEST" {}

    find "$TRASH" -type f -name '*.elc' -exec mv -t "$DEST" {}

    find "$TRASH" -type f -name '*.iso' -exec mv -t "$DEST" {}

    find "$TRASH" -type f -name '*.rej' -exec mv -t "$DEST" {}

    find "$TRASH" -type f -name '*.el' -exec mv -t "$DEST" {}

    find "$TRASH" -xtype l -exec mv -t "$DEST" {}

    find "$TRASH" -type f -mtime +90 -exec mv -t "$DEST" {}

    find "$TRASH" -type f -empty -exec rm -f {}

    find "$TRASH" -type d -empty -exec rm -f {}

    # Files whose names are just numbers are unlikely to be worth saving
    # copies of the same file...
}

delete_orphans() {
    echo "deleting orphan packages..."
    sudo pacman -Rns $(pacman -Qdtq)
}

case "$1" in
    "")
        clean_pacman_cache
        clean_trash
        delete_orphans
        ;;
    -p|--packages)
        clean_pacman_cache
        ;;
    -t|--trash)
        clean_trash
        ;;
esac
