#!/bin/sh
# Filename: clean_system
# Author: Luis Henriquez-Perez <luis@luishp.xyz>
# Created: 2025-06-30 09:22:54
# Description: This is a script for cleaning my system.

trash="$HOME/Trash/"

clean_pacman_cache() {
    echo "Cleaning cache..."
    # Keep last N versions of each package in pacman cache (without using paccache)
    KEEP=3
    CACHE_DIR="/var/cache/pacman/pkg"
    IGNORE_LIST=("emacs")

    cd "$CACHE_DIR" || exit 1

    # Use associative array to group packages by base name
    declare -A packages

    for pkg in *.pkg.tar.*; do
        # Extract base name: remove last 3 hyphen-separated fields
        base=$(echo "$pkg" | sed -E 's/-[^-]+-[^-]+-[^-]+\.pkg\.tar\..+//' )

        # Check if this package should be ignored
        for ignore in "${IGNORE_LIST[@]}"; do
            if [[ "$base" == "$ignore" ]]; then
                continue 2  # skip this pkg
            fi
        done

        packages["$base"]+=$'\n'"$pkg"
    done

    for base in "${!packages[@]}"; do
        # Get all package versions for this base, sorted by modification time (newest first)
        pkgs_sorted=$(echo "${packages[$base]}" | sed '/^$/d' | xargs -d '\n' ls -t 2>/dev/null)

        # Keep only the first $KEEP lines, delete the rest
        i=0
        echo "$pkgs_sorted" | while IFS= read -r pkg; do
            i=$((i + 1))
            if [ "$i" -le "$KEEP" ]; then
                continue
            fi
            echo "Deleting old cached version: $pkg"
            # rm -f -- "$pkg"
        done
    done
}

clean_trash() {
    echo "Cleaning the trash directory..."

    # If the wallpaper count is over 100, delete the oldest ones so that the
    # count is 100.  I do not know about this rule.  It is rather arbitrary but
    # for now it is fine.
    tempfile=$(mktemp)
    find "$trash" -type f \( -name '*wallhaven-*.jpg' -o -name '*wallhaven-*.png' \) -printf '%T@ %p\n' \
        | sort -n \
        | awk -v outfile="$tempfile" '
{
    files[NR] = $2
}
END {
    total = NR
    if (total > 100) {
        to_delete = total - 100
        print "Deleting ", to_delete, "wallpapers out of" , total > "/dev/stderr"
        for (i = 1; i <= to_delete; i++) print files[i]
        print to_delete > outfile
    } else {
        print 0 > outfile
    }
}' \
        | xargs -r rm --
    rm -f "$tempfile"

    local deleted_pycache=0
    local deleted_pyc=0
    local deleted_elc=0
    local deleted_empty_dirs=0
    local deleted_empty_files=0
    local deleted_old=0
    local deleted_iso=0
    local deleted_symlinks=0

    for item in "$trash"/*; do
        # Skip if the glob doesn't match anything
        [ -e "$item" ] || continue
        # Skip wallpapers, I handle that above.
        case "$(basename "$item")" in
            *wallhaven-*.jpg | *wallhaven-*.png)
                continue
                ;;
        esac

        case "$item" in
            */__pycache__)
                rm -rf "$item" && ((deleted_pycache++))
                ;;

            *.pyc|*.pyo)
                rm -f "$item" && ((deleted_pyc++))
                ;;

            *.elc)
                rm -f "$item" && ((deleted_elc++))
                ;;

            *.iso)
                rm -f "$item" && ((deleted_iso++))
                ;;

            *)
                if [ -L "$item" ] && [ ! -e "$item" ]; then
                    rm -f "$item" && ((deleted_symlinks++))
                elif [ -f "$item" ] && [ ! -s "$item" ]; then
                    rm -f "$item" && ((deleted_empty_files++))
                elif [ -d "$item" ] && [ -z "$(ls -A "$item")" ]; then
                    rmdir "$item" && ((deleted_empty_dirs++))
                elif [ -f "$item" ] && [ "$(find "$item" -mtime +90)" ]; then
                    rm -f "$item" && ((deleted_old++))
                fi
                ;;
        esac
    done

    echo "Deleted $deleted_pycache __pycache__ directories..."
    echo "Deleted $deleted_pyc Python compiled files (.pyc, .pyo)..."
    echo "Deleted $deleted_elc elisp compiled files..."
    echo "Deleted $deleted_empty_dirs empty directories..."
    echo "Deleted $deleted_empty_files empty files..."
    echo "Deleted $deleted_old very old files (over 90 days)..."
    echo "Deleted $deleted_iso ISOs..."
    echo "Deleted $deleted_symlinks broken symlinks..."
}

# clean_dir() {
#     pass
#     # Move all backup and lock files into trash.
# }

case "$1" in
    "")
        clean_pacman_cache
        clean_trash
        ;;
    -p|--packages)
        clean_pacman_cache
           ;;
    -t|--trash)
        clean_trash
           ;;
esac
